<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement xmlns:ui="UnityEngine.UIElements" style="flex-grow: 1; position: relative; flex-shrink: 1; flex-wrap: nowrap; opacity: 1;">
        <ui:VisualElement name="Pointers" style="position: absolute; top: 0; right: 0; flex-grow: 0; align-self: center; width: auto; aspect-ratio: 1; height: 25%; margin-right: 16px; margin-top: 16px; justify-content: center; align-content: center; align-items: stretch;"/>
        <ui:VisualElement name="Radar" style="position: relative; bottom: auto; left: 0; flex-grow: 1; align-self: flex-start; justify-content: flex-end; width: auto; margin-left: 16px;">
            <ui:Image image="project://database/Assets/OneDrive/spaceHUD/radar/background.svg" source="project://database/Assets/OneDrive/spaceHUD/radar/background.svg?fileID=7388822144124034973&amp;guid=ff001e41133b85d448f4768ce6fddda1&amp;type=3#background" scale-mode="ScaleAndCrop" style="width: 100%; height: 50%; align-items: center; align-content: auto; flex-basis: auto; justify-content: center; align-self: center; aspect-ratio: 1;">
                <ui:Image source="project://database/Assets/OneDrive/spaceHUD/radar/radarspin.svg?fileID=7388822144124034973&amp;guid=3383506a50c17904092efb16afb75692&amp;type=3#radarspin" name="radarspin" style="width: 50%; height: 50%; transform-origin: left bottom; right: 0; top: 0%; position: absolute; rotate: 0;"/>
            </ui:Image>
        </ui:VisualElement>
        <ui:VisualElement name="NumberReadings" style="position: relative; bottom: auto; left: auto; flex-grow: 0; justify-content: space-evenly; align-items: flex-start; align-self: flex-start; height: 25%; margin-bottom: 16px; margin-top: 16px; margin-right: 0; margin-left: 16px;">
            <ui:Label name="zoomLabel" text="Z: 1" style="font-size: 65px; -unity-font-style: normal; align-items: stretch; align-self: flex-start; color: rgb(0, 206, 255); -unity-font-definition: url(&quot;project://database/Assets/OneDrive/fonts/Grand9KPixel.ttf?fileID=12800000&amp;guid=ac65a61801306cd46973b1c62a65d2b2&amp;type=3#Grand9KPixel&quot;);"/>
            <ui:Label name="xposLabel" text="X: 00000" style="font-size: 65px; -unity-font-style: normal; color: rgb(0, 206, 255); -unity-font-definition: url(&quot;project://database/Assets/OneDrive/fonts/Grand9KPixel.ttf?fileID=12800000&amp;guid=ac65a61801306cd46973b1c62a65d2b2&amp;type=3#Grand9KPixel&quot;);"/>
            <ui:Label name="yposLabel" text="Y: 00000" style="font-size: 65px; -unity-font-style: normal; color: rgb(0, 206, 255); -unity-font-definition: url(&quot;project://database/Assets/OneDrive/fonts/Grand9KPixel.ttf?fileID=12800000&amp;guid=ac65a61801306cd46973b1c62a65d2b2&amp;type=3#Grand9KPixel&quot;);"/>
            <ui:Label name="speedLabel" text="V: 00.000" style="font-size: 65px; -unity-font-style: normal; color: rgb(0, 206, 255); -unity-font-definition: url(&quot;project://database/Assets/OneDrive/fonts/Grand9KPixel.ttf?fileID=12800000&amp;guid=ac65a61801306cd46973b1c62a65d2b2&amp;type=3#Grand9KPixel&quot;);"/>
        </ui:VisualElement>
        <ui:VisualElement style="position: relative; bottom: 0; left: 0; right: 0; flex-direction: row; -unity-text-align: upper-left; justify-content: center; flex-grow: 0; align-items: stretch; align-self: stretch; align-content: flex-start; top: auto; width: 100%; height: 25%; padding-top: 8px;">
            <ui:VisualElement name="VelocityBars" style="flex-grow: 0; flex-direction: row; aspect-ratio: 1; height: 100%;">
                <ui:Image source="project://database/Resources/unity_builtin_extra?fileID=10305&amp;guid=0000000000000000f000000000000000&amp;type=0#Default-Checker" scale-mode="StretchToFill" tint-color="rgb(0, 206, 255)" uv="0,0,1,1" name="DL1" style="width: 100%; height: 5px; position: absolute;"/>
                <ui:Image image="project://database/Assets/OneDrive/spaceHUD/measurebar/1.svg" source="project://database/Assets/OneDrive/spaceHUD/measurebar/1%20(2).svg?fileID=7388822144124034973&amp;guid=a2e2d650e30a7fd4fb9605a239700005&amp;type=3#1 (2)" style="margin-right: 0; flex-grow: 1; align-items: stretch; padding-top: 16px; padding-bottom: 16px; padding-left: 16px;"/>
