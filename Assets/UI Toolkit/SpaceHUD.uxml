<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement xmlns:ui="UnityEngine.UIElements" style="flex-grow: 1; position: relative; flex-shrink: 1; flex-wrap: nowrap; opacity: 1;">
        <ui:VisualElement name="Pointers" style="position: absolute; top: 0; right: 0; flex-grow: 0; align-self: center; width: auto; aspect-ratio: 1; height: 25%; margin-right: 16px; margin-top: 16px; justify-content: center; align-content: center; align-items: stretch;"/>
        <ui:VisualElement name="Radar" style="position: relative; bottom: auto; left: 0; flex-grow: 1; align-self: flex-start; justify-content: flex-end; width: auto; margin-left: 16px;">
            <ui:Image image="project://database/Assets/OneDrive/spaceHUD/radar/background.svg" source="project://database/Assets/Art/svg/spaceHUD/radar/HUD_radar_base.svg?fileID=7388822144124034973&amp;guid=64d617dce580aa841bf013f7baa35533&amp;type=3#HUD_radar_base" scale-mode="ScaleAndCrop" name="RadarImage" style="width: 100%; height: 50%; align-items: center; align-content: auto; flex-basis: auto; justify-content: center; align-self: center; aspect-ratio: 1;">
                <ui:Image source="project://database/Assets/Art/svg/spaceHUD/radar/HUD_radar_spinner.svg?fileID=7388822144124034973&amp;guid=3eb48259212912d4ebac6c56e9056712&amp;type=3#HUD_radar_spinner" name="radarspin" style="width: 50%; height: 50%; transform-origin: left bottom; right: 0; top: 0%; position: absolute; rotate: 0;"/>
            </ui:Image>
        </ui:VisualElement>
        <ui:VisualElement name="NumberReadings" style="position: relative; bottom: auto; left: auto; flex-grow: 0; justify-content: space-evenly; align-items: flex-start; align-self: flex-start; height: 25%; margin-bottom: 16px; margin-top: 16px; margin-right: 0; margin-left: 16px;">
            <ui:Label name="zoomLabel" text="Z: 1" style="font-size: 65px; -unity-font-style: normal; align-items: stretch; align-self: flex-start; color: rgb(0, 206, 255); -unity-font-definition: url(&quot;project://database/Assets/Art/fonts/Grand9KPixel.ttf?fileID=12800000&amp;guid=7e8fccf82318c0c49bb3ac15f088efcd&amp;type=3#Grand9KPixel&quot;);"/>
            <ui:Label name="xposLabel" text="X: 00000" style="font-size: 65px; -unity-font-style: normal; color: rgb(0, 206, 255); -unity-font-definition: url(&quot;project://database/Assets/Art/fonts/Grand9KPixel.ttf?fileID=12800000&amp;guid=7e8fccf82318c0c49bb3ac15f088efcd&amp;type=3#Grand9KPixel&quot;);"/>
            <ui:Label name="yposLabel" text="Y: 00000" style="font-size: 65px; -unity-font-style: normal; color: rgb(0, 206, 255); -unity-font-definition: url(&quot;project://database/Assets/Art/fonts/Grand9KPixel.ttf?fileID=12800000&amp;guid=7e8fccf82318c0c49bb3ac15f088efcd&amp;type=3#Grand9KPixel&quot;);"/>
            <ui:Label name="speedLabel" text="V: 00.000" style="font-size: 65px; -unity-font-style: normal; color: rgb(0, 206, 255); -unity-font-definition: url(&quot;project://database/Assets/Art/fonts/Grand9KPixel.ttf?fileID=12800000&amp;guid=7e8fccf82318c0c49bb3ac15f088efcd&amp;type=3#Grand9KPixel&quot;);"/>
        </ui:VisualElement>
        <ui:VisualElement style="position: relative; bottom: 0; left: 0; right: 0; flex-direction: row; -unity-text-align: upper-left; justify-content: center; flex-grow: 0; align-items: stretch; align-self: stretch; align-content: flex-start; top: auto; width: 100%; height: 25%; padding-top: 8px;">
            <ui:VisualElement name="VelocityBars" style="flex-grow: 0; flex-direction: row; aspect-ratio: 1; height: 100%;">
                <ui:Image source="project://database/Resources/unity_builtin_extra?fileID=10305&amp;guid=0000000000000000f000000000000000&amp;type=0#Default-Checker" scale-mode="StretchToFill" tint-color="rgb(0, 206, 255)" uv="0,0,1,1" name="DL1" style="width: 100%; height: 5px; position: absolute;"/>
                <ui:Image image="project://database/Assets/OneDrive/spaceHUD/measurebar/1.svg" source="project://database/Assets/Art/svg/spaceHUD/vertical_measurebar/HUD_vertical_measurebar_0.svg?fileID=7388822144124034973&amp;guid=f7c565ba5ad8b314dad34ab6b2869862&amp;type=3#HUD_vertical_measurebar_0" name="Image" style="margin-right: 0; flex-grow: 1; align-items: stretch; padding-top: 16px; padding-bottom: 16px; padding-left: 16px;"/>
                <ui:Image image="project://database/Assets/OneDrive/spaceHUD/measurebar/1.svg" source="project://database/Assets/Art/svg/spaceHUD/vertical_measurebar/HUD_vertical_measurebar_0.svg?fileID=7388822144124034973&amp;guid=f7c565ba5ad8b314dad34ab6b2869862&amp;type=3#HUD_vertical_measurebar_0" style="margin-right: 0; margin-left: 0; flex-grow: 1; padding-top: 16px; padding-bottom: 16px; padding-right: 16px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ControlPanel" style="flex-direction: column; flex-grow: 1; align-self: auto;">
                <ui:Image image="project://database/Assets/OneDrive/spaceHUD/compass/base.svg" source="project://database/Assets/Art/svg/spaceHUD/compass/HUD_compass_base.svg?fileID=7388822144124034973&amp;guid=5e3c908e2cf4567458515f4674b9413a&amp;type=3#HUD_compass_base" name="Compass" style="margin-bottom: 24px; align-self: stretch; flex-grow: 1; margin-right: 16px; margin-left: 16px; margin-top: 8px;"/>
                <ui:VisualElement name="VelocityGrid" style="flex-direction: row; flex-grow: 1;">
                    <ui:Image image="project://database/Assets/OneDrive/spaceHUD/grid/Grid.svg" source="project://database/Assets/Art/svg/spaceHUD/grid/HUD_grid_base.svg?fileID=7388822144124034973&amp;guid=c30ec7719ca2bb743a08c3f1fde18705&amp;type=3#HUD_grid_base" style="aspect-ratio: 1;">
                        <ui:Image source="project://database/Assets/Art/svg/spaceHUD/grid/HUD_grid_red_dot.svg?fileID=7388822144124034973&amp;guid=978c6431d2925544bb868d737ee4e19f&amp;type=3#HUD_grid_red_dot" name="RedGridMarker" style="position: absolute; top: 45%; left: 45%; width: 10%; height: 10%; right: auto; bottom: auto;"/>
                        <ui:Image source="project://database/Assets/Art/svg/spaceHUD/grid/HUD_grid_green_dot.svg?fileID=7388822144124034973&amp;guid=59881e88fa4673b4e84054a14a168ad1&amp;type=3#HUD_grid_green_dot" name="GreenGridMarker" style="position: absolute; top: 45%; left: 45%; width: 10%; height: 10%; right: auto; bottom: auto;"/>
                    </ui:Image>
                    <ui:VisualElement style="flex-direction: column; margin-left: 2px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; justify-content: space-between; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; width: 5%; flex-grow: 0;">
                        <ui:Image image="project://database/Assets/OneDrive/spaceHUD/button/off.svg" source="project://database/Assets/Art/svg/spaceHUD/button/HUD_button_off.svg?fileID=7388822144124034973&amp;guid=8667882b9ad1a7e4b968c7a5ea4d0551&amp;type=3#HUD_button_off" name="Thrusters" style="flex-grow: 1; aspect-ratio: 1;"/>
                        <ui:Image image="project://database/Assets/OneDrive/spaceHUD/button/off.svg" source="project://database/Assets/Art/svg/spaceHUD/button/HUD_button_off.svg?fileID=7388822144124034973&amp;guid=8667882b9ad1a7e4b968c7a5ea4d0551&amp;type=3#HUD_button_off" name="ConType" style="flex-grow: 1; aspect-ratio: 1;"/>
                        <ui:Image image="project://database/Assets/OneDrive/spaceHUD/button/off.svg" source="project://database/Assets/Art/svg/spaceHUD/button/HUD_button_off.svg?fileID=7388822144124034973&amp;guid=8667882b9ad1a7e4b968c7a5ea4d0551&amp;type=3#HUD_button_off" name="PointerIndicator" style="flex-grow: 1; aspect-ratio: 1;"/>
                    </ui:VisualElement>
