                    <ui:Image source="project://database/Resources/unity_builtin_extra?fileID=10305&amp;guid=0000000000000000f000000000000000&amp;type=0#Default-Checker" scale-mode="StretchToFill" tint-color="rgb(0, 206, 255)" uv="0,0,1,1" name="DL3" style="width: 100%; height: 5px; align-self: flex-end;"/>
                    <ui:Image source="project://database/Resources/unity_builtin_extra?fileID=10305&amp;guid=0000000000000000f000000000000000&amp;type=0#Default-Checker" scale-mode="StretchToFill" tint-color="rgb(0, 206, 255)" uv="0,0,1,1" name="DL4" style="width: 5px; height: 100%; rotate: 0; align-self: flex-end;"/>
