                    </ui:Image>
                    <ui:VisualElement style="flex-direction: column; margin-left: 2px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; justify-content: space-between; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; width: 5%; flex-grow: 0;">
                        <ui:Image image="project://database/Assets/OneDrive/spaceHUD/button/off.svg" source="project://database/Assets/OneDrive/spaceHUD/button/button%20off.svg?fileID=7388822144124034973&amp;guid=a557789f193dd3f4c8e60e9fce15846b&amp;type=3#button off" style="flex-grow: 1; aspect-ratio: 1;"/>
                        <ui:Image image="project://database/Assets/OneDrive/spaceHUD/button/off.svg" source="project://database/Assets/OneDrive/spaceHUD/button/button%20off.svg?fileID=7388822144124034973&amp;guid=a557789f193dd3f4c8e60e9fce15846b&amp;type=3#button off" style="flex-grow: 1; aspect-ratio: 1;"/>
                        <ui:Image image="project://database/Assets/OneDrive/spaceHUD/button/off.svg" source="project://database/Assets/OneDrive/spaceHUD/button/button%20off.svg?fileID=7388822144124034973&amp;guid=a557789f193dd3f4c8e60e9fce15846b&amp;type=3#button off" style="flex-grow: 1; aspect-ratio: 1;"/>
